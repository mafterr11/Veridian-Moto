{
  "name": "veridian-moto",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:prod": "pnpm audit --prod",
    "env:check:production": "node --import tsx src/scripts/check-production-env.ts",
    "smoke:production": "node --import tsx src/scripts/smoke-production.ts",
    "release:check": "pnpm check && pnpm audit:prod",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:doctor": "node --import tsx src/scripts/check-database.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --import tsx src/db/seed.ts",
    "db:admin": "node --import tsx src/db/provision-admin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:check && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
