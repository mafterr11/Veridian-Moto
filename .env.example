# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and publishable key. These two values may reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required locally by `pnpm db:admin`; do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase transaction-pooler PostgreSQL URL (normally port 6543). This is used
# by the Vercel runtime. Keep it server-only.
DATABASE_URL=

# Direct PostgreSQL URL used only from a trusted workstation or CI to apply
# migrations. Do not add this value to Vercel's runtime environment.
MIGRATION_DATABASE_URL=

# The only Auth email accepted by the application, in addition to an active
# admin_profiles row for the same user UUID.
ADMIN_EMAIL=

# Server-only HMAC key for privacy-preserving public-action rate limits.
# Generate at least 32 random characters (for example: `openssl rand -base64 32`).
RATE_LIMIT_SECRET=

# Added in Phase 7: transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_NOTIFICATION_EMAIL=
